# ---------------------------------------------------------------------------
# Vista previa en el VPS compartido — copia este archivo a deploy/.env.preview y completa los valores.
# NUNCA lo subas al repositorio (ya está ignorado). Guía: docs/vistas-previas-vps.md del repositorio del ERP.
# Secretos:  openssl rand -hex 24   (uno distinto para cada variable)
# ---------------------------------------------------------------------------

# Dirección pública de la vista previa: la muestra  bash edge.sh host comprasmio  (en deploy/ del ERP).
PREVIEW_HOST=comprasmio.1-2-3-4.sslip.io

POSTGRES_PASSWORD=
JWT_SECRET=
FILE_SIGNING_SECRET=

# Primera cuenta del panel (se crea al arrancar si no existe). Usa una clave fuerte: la dirección es pública.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# Video en vivo (opcional; LiveKit Cloud). Vacío = la sala muestra un bloque de color en lugar de la cámara.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
