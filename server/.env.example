# Copiá este archivo como ".env" y pegá tus credenciales de LiveKit Cloud.
# El archivo .env NO se sube a git ni se comparte: contiene secretos.

# Se ve en tu proyecto de LiveKit Cloud, arriba. Empieza con wss://
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud

# Settings → Keys. El secreto se muestra una sola vez al crearlo.
# Si el secreto contiene un "#", ponelo entre comillas dobles: de lo contrario
# este archivo corta el valor ahí y lo deja truncado sin avisar.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Opcional
PORT=4000
JWT_SECRET=cambiame-en-produccion
