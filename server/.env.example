# Copiá este archivo como ".env" para desarrollo. El archivo .env NO se sube a git:
# contiene secretos. En Render, estas variables se cargan en el panel (ver render.yaml).

# Base de datos. En desarrollo no hace falta: `npm run db` levanta un PostgreSQL local
# en 127.0.0.1:54329 y el servidor lo usa por defecto.
# DATABASE_URL=postgres://usuario:clave@host:5432/comprasmio

# Secretos (en producción, valores largos y aleatorios; Render los genera solo).
JWT_SECRET=cambiame-en-produccion
FILE_SIGNING_SECRET=cambiame-en-produccion

# URL pública del servidor (para armar los enlaces de archivos).
# PUBLIC_URL=https://comprasmio.onrender.com

# Primera cuenta del panel de administración: se crea al arrancar si no existe.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=          # al menos 10 caracteres

# Archivos (fotos, comprobantes, QR). Sin bucket, en desarrollo se guardan en disco
# (carpeta uploads/). En producción hace falta un bucket compatible con S3, por ejemplo
# Cloudflare R2: Endpoint = https://<cuenta>.r2.cloudflarestorage.com
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=auto

# Video en vivo (opcional). Sin esto, la sala muestra el bloque de color.
# Se ve en tu proyecto de LiveKit Cloud. Si el secreto contiene "#", ponelo entre comillas.
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

PORT=4000
